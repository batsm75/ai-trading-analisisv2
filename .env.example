# ============================================================
#  AI TRADING TERMINAL — Contoh file environment
#  Salin file ini menjadi ".env" lalu isi API KEY asli Anda.
#  JANGAN pernah commit file .env ke GitHub.
# ============================================================

# --- DEEPSEEK (Otak utama & analisis utama) ---
# Dapatkan di: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- GEMINI (Analisis chart pattern otomatis) ---
# Key format baru: AQ.xxxxx  (Google AI Studio)
# Dapatkan di: https://aistudio.google.com/apikey
# Model: gemini-2.5-flash
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- DEATCODE (Cadangan / fallback jika Gemini limit) ---
# Console: https://console.deatcode.com/
# Key format: dc_live_xxxxx
# Jika Gemini kena rate limit, otomatis dialihkan ke GPT-4o via Deatcode.
DEATCODE_API_KEY=dc_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEATCODE_BASE_URL=https://api.deatcode.com/v1
DEATCODE_MODEL=gpt-4o

# --- TWELVEDATA (Data market: harga, OHLC, timeframe) ---
# Dapatkan di: https://twelvedata.com/register
TWELVEDATA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWELVEDATA_BASE_URL=https://api.twelvedata.com

# --- SOSOVALUE (Data market tambahan / fundamental & sentimen) ---
# Dapatkan di dashboard SoSoValue Anda
SOSOVALUE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SOSOVALUE_BASE_URL=https://api.sosovalue.com

# --- PENGATURAN APLIKASI ---
# Simbol default (misal EUR/USD, BTC/USD, XAU/USD)
DEFAULT_SYMBOL=EUR/USD
# Timeframe default: 1min, 5min, 15min, 30min, 1h, 4h, 1day
DEFAULT_TIMEFRAME=15min
# Jumlah candlestick yang diambil untuk analisis
CANDLE_LIMIT=100
# Request timeout (detik)
REQUEST_TIMEOUT=30
