# ============================================================
# KONFIGURASI API KEY — salin file ini menjadi ".env"
#   cp .env.example .env
# Lalu isi setiap kolom dengan API key milik Anda.
# File .env TIDAK akan ter-upload ke GitHub (sudah di .gitignore).
# ============================================================

# --- Gemini (otak AI utama, analisis chart pattern) ---
# Buat key di https://aistudio.google.com/app/apikey
# Format baru bisa berupa "AQ.xxxxx" atau lama "AIza..." — keduanya didukung.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Deatcode (cadangan, otomatis aktif jika Gemini kena limit) ---
# Dashboard: https://console.deatcode.com/
# Endpoint TERKONFIRMASI: https://api.deatcode.com/v1 (OpenAI-compatible, POST /chat/completions).
# CATATAN: model "gpt-4o" TIDAK ADA di Deatcode. Pilihan GPT yang tersedia antara lain:
#   gpt-5-mini (paling hemat, default), gpt-5.4, gpt-5.5, gpt-6-luna, gpt-6-astra,
#   atau non-GPT: deepseek-flash, gemini-2.5-pro, claude-sonnet-4.5, dll.
# Butuh saldo kredit agar chat completion berjalan (cek via menu 3. Env -> [t] Tes koneksi).
DEATCODE_API_KEY=dc_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEATCODE_MODEL=gpt-5-mini
DEATCODE_BASE_URL=https://api.deatcode.com/v1

# --- TwelveData (market data: forex, saham, crypto, indeks) ---
# Daftar gratis: https://twelvedata.com/
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com

# --- SoSoValue (market data crypto tambahan) ---
# Daftar: https://sosovalue.com/developer  |  Docs: https://sosovalue.gitbook.io/soso-value-api-doc
# Auth via header "x-soso-api-key".
SOSOVALUE_API_KEY=
SOSOVALUE_BASE_URL=https://openapi.sosovalue.com/openapi/v1
# Path endpoint kline (relatif terhadap base URL). Sesuaikan jika dokumentasi terbaru berubah.
SOSOVALUE_KLINE_PATH=/currency/historical-klines
